<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CodexLocalInbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CodexLocalInbox"
    xmlns:models="using:CodexLocalInbox.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootPage">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Codex Inbox" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Local completion notifications" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh inbox" />
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Inbox status"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="False" />

        <Grid Grid.Row="2">
            <TextBlock Text="Loading notifications…"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock Text="Your inbox is empty"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="New completed turns will appear here."
                           HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsErrorState), Mode=OneWay}">
                <TextBlock Text="The inbox could not be loaded"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Try again"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.AutomationId="RetryButton"
                        AutomationProperties.Name="Try loading the inbox again" />
            </StackPanel>

            <ListView ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                      Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasEntries), Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      AutomationProperties.AutomationId="InboxList"
                      AutomationProperties.Name="Codex notification list">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:InboxEntry">
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind OccurredDisplay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind Repository}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind ObservedStatus}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3"
                                           Text="{x:Bind DisplayError}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind local:MainPage.BoolToVisibility(IsError), Mode=OneTime}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,8,0,0">
                                    <Button Content="Resume"
                                            Command="{Binding DataContext.ResumeCommand, ElementName=RootPage}"
                                            CommandParameter="{x:Bind}"
                                            IsEnabled="{x:Bind local:MainPage.NotBool(IsError), Mode=OneTime}"
                                            AutomationProperties.AutomationId="{x:Bind ResumeAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind local:MainPage.ActionName('Resume', Title), Mode=OneTime}" />
                                    <Button Content="Open result"
                                            Command="{Binding DataContext.OpenResultCommand, ElementName=RootPage}"
                                            CommandParameter="{x:Bind}"
                                            IsEnabled="{x:Bind HasResult, Mode=OneTime}"
                                            Visibility="{x:Bind local:MainPage.BoolToVisibility(HasResult), Mode=OneTime}"
                                            AutomationProperties.AutomationId="{x:Bind ResultAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind local:MainPage.ActionName('Open result', Title), Mode=OneTime}" />
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=RootPage}"
                                            CommandParameter="{x:Bind}"
                                            AutomationProperties.AutomationId="{x:Bind DeleteAutomationId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind local:MainPage.ActionName('Delete', Title), Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
