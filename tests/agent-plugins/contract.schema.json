{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suusanex/coding_agent_plan_and_verify_process/tests/agent-plugins/contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "installTargets", "ownedSkills", "ownedAgents", "ownedInstructions", "dependencies", "runtimeBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": { "type": "string", "minLength": 1 },
    "installTargets": { "type": "array", "minItems": 1, "items": { "enum": ["copilot", "codex", "agent-skills"] }, "uniqueItems": true },
    "ownedSkills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "ownedAgents": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "ownedInstructions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "runtimeBoundary": { "type": "string", "minLength": 1 }
  }
}
