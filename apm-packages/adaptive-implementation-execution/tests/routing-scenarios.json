{
  "schema_version": 4,
  "contract": "adaptive-implementation-execution",
  "required_decision_surfaces": [
    "responsibility_ownership",
    "cross_file_ownership",
    "public_contract",
    "shared_internal_contract",
    "dependency_direction_new_dependency",
    "production_sequence",
    "di_factory_entrypoint_structure",
    "state_ownership",
    "error_semantics",
    "cancellation_semantics",
    "retry_semantics",
    "test_architecture_seam_harness",
    "binding_compliance"
  ],
  "required_reentry_state": [
    "original_implementation_intent",
    "bounded_residual_handoff",
    "decision_surface_reentry_handoff",
    "implementation_route",
    "implementation_route_source",
    "design_pair_handoff",
    "locked_decisions",
    "current_worktree_state",
    "decision_surface_evidence",
    "completed_work",
    "files_changed",
    "validation",
    "new_decision",
    "reentry_count",
    "trigger"
  ],
  "scenarios": [
    {
      "id": "A",
      "name": "implementation-evidence-before-transfer",
      "route": { "implementation_route": "adaptive", "implementation_route_source": "default", "design_pair_handoff": "N/A" },
      "events": [
        { "kind": "start", "owner": "decision-surface-implementation-owner" },
        {
          "kind": "verdict",
          "owner": "decision-surface-implementation-owner",
          "verdict": "READY_FOR_BOUNDED_RESIDUAL_IMPLEMENTATION",
          "handoff": {
            "valid": true,
            "ownership_transfer_basis": "bounded-residual-work-only",
            "implementation_evidence": [
              "Production sequence was implemented through the existing composition root",
              "Focused tests demonstrated the selected state ownership"
            ],
            "reentry_count": 0,
            "previous_reentry_trigger": "N/A",
            "reentry_progress_evidence": "N/A",
            "decision_surface_assessment": {
              "responsibility_ownership": { "status": "Resolved", "evidence": "QueueConsumer owns one-item consumption" },
              "cross_file_ownership": { "status": "Resolved", "evidence": "Composition root owns registration and QueueConsumer owns behavior" },
              "public_contract": { "status": "Resolved", "evidence": "IQueueConsumer signature is exercised by the caller" },
              "shared_internal_contract": { "status": "N/A", "evidence": "No shared internal contract changes" },
              "dependency_direction_new_dependency": { "status": "N/A", "evidence": "No new dependency or edge" },
              "production_sequence": { "status": "Resolved", "evidence": "Implemented sequence passed the focused test" },
              "di_factory_entrypoint_structure": { "status": "Resolved", "evidence": "Existing scoped registration is exercised" },
              "state_ownership": { "status": "Resolved", "evidence": "Consumer retains no state between calls" },
              "error_semantics": { "status": "Resolved", "evidence": "Existing exception propagation is preserved" },
              "cancellation_semantics": { "status": "N/A", "evidence": "No cancellable operation in scope" },
              "retry_semantics": { "status": "N/A", "evidence": "No retry behavior in scope" },
              "test_architecture_seam_harness": { "status": "Resolved", "evidence": "Existing fake queue seam executed the production entrypoint" },
              "binding_compliance": { "status": "N/A", "evidence": "No Design Pair or additional binding input" }
            },
            "acceptance_status": [
              { "acceptance_item": "AC-1", "status": "Incomplete", "work_ids": ["RW-1"], "evidence": "Core sequence is proven; equivalent cases remain" }
            ],
            "remaining_work": [
              {
                "work_id": "RW-1",
                "acceptance_items": ["AC-1"],
                "responsibility": "Complete equivalent mappings and tests",
                "authorized_surface": ["src/Queue", "tests/Queue"],
                "expected_behavior": "Apply the proven sequence to remaining queue item kinds",
                "locked_boundaries": ["IQueueConsumer signature", "scoped registration", "error propagation"],
                "local_freedom": ["private helpers", "branch organization", "fixture organization"],
                "completion_check": ["dotnet test --filter QueueConsumer"]
              }
            ],
            "allowed_edit_surface": ["src/Queue", "tests/Queue"]
          }
        },
        { "kind": "start", "owner": "bounded-residual-implementation-owner" },
        { "kind": "verdict", "owner": "bounded-residual-implementation-owner", "verdict": "IMPLEMENTATION_COMPLETED", "changed_locked_decision": false }
      ],
      "expected": { "final_state": "Completed", "bounded_residual_starts": 1 }
    },
    {
